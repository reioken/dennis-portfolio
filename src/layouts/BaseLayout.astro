---
import '../styles/global.css';
import '../styles/arcade-interface.css';
import { ClientRouter } from 'astro:transitions';
import gateEditorCss from '../styles/gate-editor.css?url';
import GlassNav from '../components/nav/GlassNav';
import BrandLockup from '../components/brand/BrandLockup';
import FxBoot from '../components/FxBoot';
import SiteGate from '../components/gate/SiteGate';
import { navItems, site } from '../lib/site';
import { copy } from '../lib/i18n';
import { p } from '../lib/paths';
import { GATE } from '../lib/gate-config';
import { getCollection } from 'astro:content';
import BackToTop from '../components/footer/BackToTop';
import outfitWoff2 from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Vollbild-Seiten (Spielhalle): kein Footer, kein Seitenrand */
  bare?: boolean;
  /**
   * Seitenmodus für die persistente Spielhalle: `hall` = Startseite, `case` = Projektseite über der
   * Halle, `arcade` = Web-Build auf dem Automaten, `page` = normale Seite. Steht serverseitig am
   * <body>, damit das Layout nach einem Client-Seitenwechsel im ersten Frame stimmt.
   */
  mode?: 'page' | 'hall' | 'case' | 'arcade';
  /** Station der Halle für die Leiste: Zähler, Name, Version (Seiten ohne Halle: weglassen) */
  station?: { index: number; total: number; title: string; titleEn?: string; version?: string };
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.description,
  ogImage = 'og/default.png',
  mode = 'page',
  bare = mode !== 'page',
  station,
} = Astro.props;

const path = Astro.url.pathname;
const nav = navItems.map((n) => ({ href: p(n.href), labelKey: n.labelKey }));
const canonical = new URL(path, Astro.site ?? site.url).toString();
const favicon = p('favicon.svg');
const appleIcon = p('apple-touch-icon.png');
const og = new URL(p(ogImage.replace(/^\//, '')), Astro.site ?? site.url).toString();
/** Only the default OG asset is a true 1200×630 card — don't claim that for case covers. */
const ogIsDefault = ogImage.replace(/^\//, '') === 'og/default.png';
const gateOn = GATE.editor;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Rhein-Neckar-Region (Mannheim/Heidelberg)',
    addressCountry: 'DE',
  },
  sameAs: [site.links.linkedin, site.links.github],
  knowsAbout: [
    'Art Direction',
    'UI/UX Design',
    'Independent Product Development',
    'Product Design',
    'Branding',
  ],
};
---

<!doctype html>
<html lang="de" data-lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080c" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={outfitWoff2} crossorigin />
    {gateOn && <link rel="stylesheet" href={gateEditorCss} />}
    <link rel="icon" type="image/svg+xml" href={`${favicon}?v=3`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${p('favicon-32.png')}?v=3`} />
    <link rel="apple-touch-icon" href={`${appleIcon}?v=3`} />
    {/* Sprache kommt aus der Route: DE auf /…, EN auf /en/… (siehe scripts/en-routes.mjs).
        Kein localStorage-Override mehr — die URL ist die Quelle der Wahrheit. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    {ogIsDefault && <meta property="og:image:width" content="1200" />}
    {ogIsDefault && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <title>{title}</title>
    {/* Client-Router: die Spielhalle bleibt beim Seitenwechsel stehen (transition:persist).
        Emittiert nur Meta-Tags und ein externes Modul — keine CSP-Änderung. */}
    <ClientRouter fallback="swap" />
    <!-- Keep the standards-based backdrop filter intact in production.
         The CSS optimizer otherwise emits only the obsolete WebKit-prefixed
         declaration, which current Chromium ignores. -->
  </head>
  <body data-mode={mode}>
    <a class="skip-link" href="#main">
      <span data-lang="de">{copy.de.nav.skip}</span>
      <span data-lang="en">{copy.en.nav.skip}</span>
    </a>
    {gateOn && <SiteGate client:load />}
    <FxBoot client:idle />
    <GlassNav client:load items={nav} currentPath={path} brand={site.name} homeHref={p()} mode={mode} station={station} />
    <!-- Keep native fallback outside React: fetched documents parse noscript differently. -->
    <noscript>
      <style is:inline>.site-nav .site-nav__menu, .site-nav .lang-switch, .site-nav .site-nav__direct { display: none !important; }</style>
      <details class="site-nav__fallback">
        <summary class="site-nav__fallback-toggle"><span data-lang="de">{copy.de.nav.menu}</span><span data-lang="en">{copy.en.nav.menu}</span></summary>
        <nav class="site-nav__fallback-links" aria-label="Navigation">
          {nav.map((item) => <a href={item.href}><span data-lang="de">{copy.de.nav[item.labelKey]}</span><span data-lang="en">{copy.en.nav[item.labelKey]}</span></a>)}
        </nav>
      </details>
    </noscript>
    <main id="main" tabindex="-1" class={bare ? 'is-bare' : undefined}>
      <slot />
    </main>
    {bare ? null : (
    <footer class="site-footer">
      <div class="wrap flex flex-col gap-5 py-8 md:flex-row md:items-end md:justify-between md:gap-6 md:py-7">
        <a href={p()} class="min-w-0 text-[var(--text)] transition-opacity hover:opacity-90" aria-label="Home">
          <BrandLockup name={site.name} weight="footer" compact />
        </a>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3 md:justify-end">
          <nav
            class="flex flex-wrap gap-x-4 gap-y-2 text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-[var(--faint)]"
            aria-label="Footer"
          >
            <a class="inline-flex min-h-11 items-center py-1.5 transition-colors hover:text-[var(--text)]" href={p('work')}>
              <span data-lang="de">{copy.de.nav.work}</span>
              <span data-lang="en">{copy.en.nav.work}</span>
            </a>
            <a class="inline-flex min-h-11 items-center py-1.5 transition-colors hover:text-[var(--text)]" href={p('about')}>
              <span data-lang="de">{copy.de.nav.about}</span>
              <span data-lang="en">{copy.en.nav.about}</span>
            </a>
            <a class="inline-flex min-h-11 items-center py-1.5 transition-colors hover:text-[var(--text)]" href={p('contact')}>
              <span data-lang="de">{copy.de.nav.contact}</span>
              <span data-lang="en">{copy.en.nav.contact}</span>
            </a>
            <a class="inline-flex min-h-11 items-center py-1.5 transition-colors hover:text-[var(--text)]" href={p('impressum')}>
              <span data-lang="de">Impressum</span>
              <span data-lang="en">Legal notice</span>
            </a>
            <a class="inline-flex min-h-11 items-center py-1.5 transition-colors hover:text-[var(--text)]" href={p('privacy')}>
              <span data-lang="de">Datenschutz</span>
              <span data-lang="en">Privacy</span>
            </a>
          </nav>
        </div>
      </div>
      <div class="border-t border-[var(--stroke)]">
        <div class="wrap flex items-center justify-between gap-4 py-3 text-[0.7rem] text-[var(--faint)]">
          <span>© {new Date().getFullYear()} {site.name}</span>
          <BackToTop client:idle labelDe={copy.de.footer.top} labelEn={copy.en.footer.top} />
        </div>
      </div>
    </footer>
    )}
    <script>
      // Gehoistetes Modul: läuft einmal pro Sitzung. Alles Seitenbezogene hängt an astro:page-load,
      // das der ClientRouter beim ersten Laden und nach jedem Wechsel feuert.
      import { revealBoot } from '../lib/reveal-boot';
      import { focusAfterNav } from '../lib/focus-after-nav';
      document.addEventListener('astro:page-load', () => {
        revealBoot();
        focusAfterNav();
      });
    </script>
  </body>
</html>
