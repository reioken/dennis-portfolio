---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HallGuard from '../../components/hall/HallGuard.astro';
import Hall from '../../components/hall/Hall';
import CaseOverlay from '../../components/work/CaseOverlay.astro';
import CaseArticle from '../../components/work/CaseArticle.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../lib/site';
import { p } from '../../lib/paths';
import { buildHallItems } from '../../lib/hall-items';

export async function getStaticPaths() {
  const works = await getCollection('work');
  return works.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

/* Projekte mit Automat öffnen sich vor der Halle (Kamera fährt ran, Panel rechts);
   Archiv-Einträge behalten das klassische Artikel-Layout. */
const { items, directoryItems } = await buildHallItems();
const hallIdx = items.findIndex((it) => it.slug === entry.id);
const inHall = hallIdx >= 0;
const hallItem = inHall ? items[hallIdx] : undefined;
const station = inHall ? { index: hallIdx, total: items.length, title: data.title, titleEn: data.titleEn, version: hallItem && 'version' in hallItem ? hallItem.version : data.version } : undefined;

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((w) => w.id === entry.id);
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];
const asset = (src: string) => p(src.replace(/^\//, ''));
const coverSrc = asset(data.cover);
const hasBody = (entry.body ?? '').replace(/<[^>]+>/g, '').trim().length > 0;

const siteUrl = (Astro.site ?? site.url).toString();
const caseLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  creator: { '@type': 'Person', name: site.name, url: siteUrl },
  url: new URL(p(`work/${entry.id}`), siteUrl).toString(),
  image: new URL(coverSrc.replace(/^\//, ''), siteUrl).toString(),
  dateCreated: data.year,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Work', item: new URL(p('work'), siteUrl).toString() },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};
const title = `${data.title} — ${site.name}`;
---

{
  inHall ? (
    <BaseLayout title={title} description={data.summary} ogImage={coverSrc} mode="case" station={station}>
      <script type="application/ld+json" set:html={JSON.stringify(caseLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
      <HallGuard />
      <Hall client:load transition:persist="hall" transition:persist-props items={items} directoryItems={directoryItems} initialSlug={entry.id} mode="case" homeHref={p()} />
      <CaseOverlay entry={entry} items={items} index={hallIdx} homeHref={p()} hasBody={hasBody}>
        <Content />
      </CaseOverlay>
    </BaseLayout>
  ) : (
    <BaseLayout title={title} description={data.summary} ogImage={coverSrc}>
      <script type="application/ld+json" set:html={JSON.stringify(caseLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
      <CaseArticle entry={entry} prev={prev} next={next} index={idx} total={all.length} hasBody={hasBody}>
        <Content />
      </CaseArticle>
    </BaseLayout>
  )
}
