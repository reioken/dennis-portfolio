---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkFilter from '../../components/work/WorkFilter';
import { getCollection } from 'astro:content';
import { site } from '../../lib/site';
import { copy } from '../../lib/i18n';
import { base, p, resolveLogoLive } from '../../lib/paths';

const asset = (path: string) => p(path.replace(/^\//, ''));
/** 720 px sibling written by scripts/build-thumbs.mjs, if it exists */
const smOf = (src: string) => { const sm = src.replace(/\.(webp|jpe?g)$/i, '@sm.webp'); return sm !== src && fs.existsSync(path.join(process.cwd(), 'public', sm.replace(/^\//, ''))) ? sm : undefined; };
const works = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => ({
    slug: w.id,
    title: w.data.title,
    summary: w.data.summary,
    year: w.data.year,
    role: w.data.role,
    titleEn: w.data.titleEn,
    summaryEn: w.data.summaryEn,
    yearEn: w.data.yearEn,
    roleEn: w.data.roleEn,
    cover: asset(w.data.cover),
    coverSm: smOf(w.data.cover) ? asset(smOf(w.data.cover)!) : undefined,
    logo: w.data.logo ? asset(w.data.logo) : undefined,
    logoLive: resolveLogoLive(w.data.logoLive),
    tags: w.data.tags,
    featured: w.data.featured,
    status: w.data.status,
    platform: w.data.platform,
    coverAlt: w.data.coverAlt,
    coverAltEn: w.data.coverAltEn ?? w.data.galleryAltsEn?.[0],
    previews: w.data.platform.includes('mobile') && !w.data.platform.includes('desktop') && !w.data.document ? w.data.gallery.slice(0, 3).map((g) => asset(smOf(g) ?? g)) : [],
  }));
---

<BaseLayout
  title={`Projekte — ${site.name}`}
  description={`Projekte von ${site.name}: NEXUS, Berry, Riftcast und Mina — Product Design, UX/UI und ein Archiv älterer Arbeiten.`}
>
  <section class="section pt-[calc(var(--nav-h)+2.5rem)]">
    <div class="wrap">
      <p class="section-label">
        <span data-lang="de">{copy.de.work.label}</span>
        <span data-lang="en">{copy.en.work.label}</span>
      </p>
      <h1 class="display mb-3 text-[clamp(2rem,5.5vw,3.2rem)] leading-[1.05]">
        <span class="gradient-text">
          <span data-lang="de">{copy.de.work.title}</span>
          <span data-lang="en">{copy.en.work.title}</span>
        </span>
      </h1>
      <p class="mb-10 max-w-2xl text-[1.05rem] normal-case tracking-normal text-[var(--dim)]">
        <span data-lang="de">{copy.de.work.body}</span>
        <span data-lang="en">{copy.en.work.body}</span>
      </p>
      <WorkFilter client:load items={works} basePath={base} />
    </div>
  </section>
</BaseLayout>
