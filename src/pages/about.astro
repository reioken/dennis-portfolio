---
/**
 * Über mich — öffnet sich wie ein Projekt vor der Halle: die Kamera steht vor der Kasse
 * (Greifautomat mit der Figur), rechts sitzt das Panel mit dem Ausweis. Die Halle selbst ist
 * die persistente Insel (transition:persist), Hall.tsx kennt /about/ als Case-Route der Kasse.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HallGuard from '../components/hall/HallGuard.astro';
import Hall from '../components/hall/Hall';
import AboutOverlay from '../components/work/AboutOverlay.astro';
import { site } from '../lib/site';
import { copy } from '../lib/i18n';
import { p } from '../lib/paths';
import { buildHallItems } from '../lib/hall-items';

const { items, directoryItems } = await buildHallItems();
const kasseIndex = Math.max(0, items.findIndex((it) => it.kind === 'kasse'));
const station = { index: kasseIndex, total: items.length, title: copy.de.hall.kasseSub, titleEn: copy.en.hall.kasseSub };

const portrait = p('media/me/portrait-wide-v2-1200.webp');
const siteUrl = (Astro.site ?? site.url).toString();
const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(p('about'), siteUrl).toString(),
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.role,
    description: site.profile.de,
    url: siteUrl,
    image: new URL(portrait.replace(/^\//, ''), siteUrl).toString(),
    email: site.email,
    sameAs: [site.links.linkedin, site.links.github],
  },
};
const title = `${copy.de.about.label} — ${site.name}`;
const description = `${site.name} — Art Director, UX/UI Designer und Independent Product Builder. Verfügbar für ausgewählte Freelance-Projekte.`;
---

<BaseLayout title={title} description={description} mode="case" station={station}>
  <script type="application/ld+json" set:html={JSON.stringify(profileLd)} />
  <HallGuard />
  <Hall client:load transition:persist="hall" transition:persist-props items={items} directoryItems={directoryItems} initialSlug="kasse" mode="case" homeHref={p()} />
  <AboutOverlay items={items} index={kasseIndex} homeHref={p()} />
</BaseLayout>
