---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvailabilityStatus from '../components/brand/AvailabilityStatus.astro';
import ContactForm from '../components/contact/ContactForm';
import PanelBack from '../components/work/PanelBack.astro';
import Icon from '../components/icons/Icon';
import { site } from '../lib/site';
import { copy } from '../lib/i18n';
import HallGuard from '../components/hall/HallGuard.astro';
import Hall from '../components/hall/Hall';
import { buildHallItems } from '../lib/hall-items';
import { p } from '../lib/paths';
import '../components/work/hall-panel.css';
const { items, directoryItems } = await buildHallItems();
const station = { index: items.length - 1, total: items.length, title: 'Kontakt', titleEn: 'Contact' };

const formDe = {
  name: 'Name',
  email: 'E-Mail',
  subject: 'Betreff (optional)',
  message: 'Nachricht',
  send: 'Nachricht senden',
  sending: 'Senden…',
  success: 'Danke — deine Nachricht ist unterwegs.',
  error: 'Senden fehlgeschlagen. Versuch’s nochmal oder schreib direkt per Mail.',
  required: 'Bitte Name, E-Mail und Nachricht ausfüllen.',
  invalidEmail: 'Bitte prüf die E-Mail-Adresse — sie sieht nicht gültig aus.',
  rateLimit: 'Zu viele Versuche in kurzer Zeit. Bitte warte eine Minute und versuch es erneut.',
};

const formEn = {
  name: 'Name',
  email: 'Email',
  subject: 'Subject (optional)',
  message: 'Message',
  send: 'Send message',
  sending: 'Sending…',
  success: 'Thanks — your message is on its way.',
  error: 'Couldn’t send. Try again or email me directly.',
  required: 'Please fill in name, email, and message.',
  invalidEmail: 'Please check the email address — it doesn’t look valid.',
  rateLimit: 'Too many attempts in a short time. Please wait a minute and try again.',
};
---

<BaseLayout title={`Kontakt — ${site.name}`} description={`Kontakt zu ${site.name} — Art Direction, UX/UI und digitale Produkte.`} mode="case" station={station}>
  <HallGuard />
  <Hall client:load transition:persist="hall" transition:persist-props items={items} directoryItems={directoryItems} initialSlug="telefon" mode="case" homeHref={p()} />
  <aside class="hall-panel hall-panel--contact" aria-labelledby="contact-title">
    <div class="hall-panel__chrome"><PanelBack homeHref={p()} /></div>
    <div class="hall-panel__card">
      <div class="hall-panel__body">
        <p class="hall-panel__kind"><span data-lang="de">Kontakt</span><span data-lang="en">Contact</span></p>
        <h1 id="contact-title" class="hall-panel__title"><span data-lang="de">Kontakt</span><span data-lang="en">Contact</span></h1>
        <p class="hall-panel__summary"><span data-lang="de">{copy.de.contact.body}</span><span data-lang="en">{copy.en.contact.body}</span></p>
        <p class="contact-direct"><!--email_off--><a href={`mailto:${site.email}`}>{site.email}</a><!--/email_off--></p>
        <ContactForm client:load de={formDe} en={formEn} privacyHref={p('privacy')} privacyHrefEn={p('en/privacy')} />
        <div class="contact-profile"><AvailabilityStatus /><p><span data-lang="de">{site.location}</span><span data-lang="en">Mannheim/Heidelberg area</span></p></div>
      </div>
      <div class="hall-panel__foot contact-links">
        <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="arrow-up-right" size={14} /></a>
        <a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow-up-right" size={14} /></a>
        <a href={p('impressum')}><span data-lang="de">Impressum</span><span data-lang="en">Legal notice</span></a>
      </div>
    </div>
  </aside>
</BaseLayout>
<style>
.contact-direct { margin: 18px 0 24px; overflow-wrap: anywhere; font-size: clamp(16px, 1.3vw, 18px); color: var(--ice); }
.contact-profile { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--stroke); color: var(--dim); font-size: 14px; }
.contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding: 12px var(--pad); font-size: 13px; }
.contact-links a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; }
@media (max-width: 599px) { .contact-links { gap: 4px 20px; } }
</style>
