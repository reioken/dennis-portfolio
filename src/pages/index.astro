---
import BaseLayout from '../layouts/BaseLayout.astro';
import HallGuard from '../components/hall/HallGuard.astro';
import Hall from '../components/hall/Hall';
import { site } from '../lib/site';
import { p } from '../lib/paths';
import { buildHallItems } from '../lib/hall-items';
import { copy } from '../lib/i18n';

/* Die Stationen kommen aus src/lib/hall-items.ts — dieselbe Liste tragen auch die Projekt- und
   Arcade-Seiten, damit die Halle beim Navigieren stehen bleibt (transition:persist). */
const { items, homeSlug, initial } = await buildHallItems();
const startItem = items[initial];
const station = { index: initial, total: items.length, title: startItem && 'title' in startItem ? startItem.title : copy.de.hall.kasseSub, titleEn: startItem && 'titleEn' in startItem ? startItem.titleEn : copy.en.hall.kasseSub, version: startItem && 'version' in startItem ? startItem.version : undefined };
---

<BaseLayout
  title={`${site.name} — Art Director, UX/UI & Product Builder`}
  description={site.description}
  ogImage={'og/default.png'}
  mode="hall"
 station={station}>
  <p class="sr-only">Art Director · UX/UI Designer · Independent apps and games</p>
  <HallGuard />
  <Hall client:load transition:persist="hall" transition:persist-props items={items} initialSlug={homeSlug} mode="hall" homeHref={p()} heading={site.name} />
</BaseLayout>

