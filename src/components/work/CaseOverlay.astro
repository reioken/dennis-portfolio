---
/**
 * Das Case-Panel der Spielhalle — das Schild, gewachsen.
 * Liegt als festes Blatt rechts neben dem fokussierten Automaten (z 3, Halle z 0).
 * Alle Wege sind einfache <a href>: ClientRouter fängt sie ab, die Halle fährt die Kamera.
 * Der Slot bekommt den gerenderten MDX-Body (<Content />).
 */
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import type { HallItem, HallMachine } from '../hall/Hall';
import { copy } from '../../lib/i18n';
import { p } from '../../lib/paths';
import CaseCaptures, { type CaptureGroup } from './CaseCaptures';
import CaseDocument from './CaseDocument';
import MinaStudyEn from './MinaStudyEn.astro';
import MinaStudyDe from './MinaStudyDe.astro';
import './hall-panel.css';
import ReadingMode from './ReadingMode.astro';
import Icon from '../icons/Icon';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Alle Stationen in Hallenreihenfolge (buildHallItems().items) */
  items: HallItem[];
  /** Index dieses Eintrags in `items` */
  index: number;
  homeHref: string;
}

const { entry, items, index, homeHref } = Astro.props;
const data = entry.data;
const n = items.length;

const isMachine = (it: HallItem | undefined): it is HallMachine => Boolean(it) && it!.kind !== 'kasse' && it!.kind !== 'phone';
const station = items[index];
const machine: HallMachine | undefined = isMachine(station) ? station : undefined;

const D = copy.de;
const E = copy.en;
const P = D.panel;
const PE = E.panel;

/* ---------- Assets, wie auf der klassischen Case-Seite ---------- */
const asset = (src: string) => p(src.replace(/^\//, ''));

function hiAsset(sitePath: string): string | undefined {
  const clean = sitePath.replace(/^\//, '');
  const candidates = [clean.replace(/(\.\w+)$/, '@2x.webp'), clean.replace(/(\.\w+)$/, '@2x$1')];
  for (const rel of candidates) {
    if (fs.existsSync(path.join(process.cwd(), 'public', rel))) return p(rel);
  }
  return undefined;
}

const coverSrc = asset(data.cover);
const cover = {
  src: coverSrc,
  srcHi: hiAsset(data.cover),
  alt: data.coverAlt ?? `${data.title} Cover`,
  altEn: data.coverAltEn ?? data.galleryAltsEn?.[0],
};

const galleryOnly = data.gallery
  .map((g, i) => ({ path: g.replace(/^\//, ''), alt: data.galleryAlts?.[i], altEn: data.galleryAltsEn?.[i] }))
  .filter((g) => g.path !== data.cover.replace(/^\//, ''));

const images = [
  cover,
  ...galleryOnly.map((g, i) => ({
    src: asset(g.path),
    srcHi: hiAsset(g.path),
    alt: g.alt ?? `${data.title} — ${i + 1}`,
    altEn: g.altEn,
  })),
];

/* Kiosk-Apps zeigen Hochkant-Captures; ein Dokument-Case (Mina) hat ein Querformat-Cover */
const plainVariant: 'phone' | 'desktop' = machine?.screenFormat === 'phone' && !data.document ? 'phone' : 'desktop';

const surfaces: CaptureGroup[] = (data.surfaces ?? []).map((surface) => ({
  id: surface.id,
  labelDe: surface.labelDe,
  labelEn: surface.labelEn,
  blurbDe: surface.blurbDe,
  blurbEn: surface.blurbEn,
  variant: surface.variant,
  images: surface.gallery.map((g, i) => ({
    src: asset(g),
    srcHi: hiAsset(g),
    alt: surface.alts?.[i] ?? `${data.title} ${surface.labelDe} — ${i + 1}`,
    altEn: surface.altsEn?.[i],
  })),
}));
/* Das Cover ist immer die erste Capture */
if (surfaces.length && surfaces[0].images[0]?.src !== coverSrc) {
  surfaces[0].images = [cover, ...surfaces[0].images.filter((s) => s.src !== coverSrc)];
}

const docPages = (data.document?.pages ?? []).map((page, i) => ({
  src: asset(page),
  alt: `${data.title} Case Study — Abschnitt ${i + 1}`,
}));

const groups: CaptureGroup[] = surfaces.length
  ? surfaces
  : data.document
    ? [{ id: 'cover', labelDe: 'Cover', labelEn: 'Cover', variant: plainVariant, images: [cover] }]
    : [{ id: 'gallery', labelDe: P.captures, labelEn: PE.captures, variant: plainVariant, images }];

/* ---------- Text ---------- */
const hasBody = (entry.body ?? '').replace(/<[^>]+>/g, '').trim().length > 0;
const when = data.timeline || data.year;
const whenEn = data.timelineEn ?? data.yearEn ?? when;
const kind = machine?.kind ?? 'terminal';
const status = data.status;
const statusDe = (D.launcher.status as Record<string, string>)[status] ?? status;
const statusEn = (E.launcher.status as Record<string, string>)[status] ?? status;
const version = machine?.version ?? data.version;
const engine = machine?.engine ?? data.engine;
const brand = machine?.brand.primary ?? data.brand?.primary ?? '#ac8bfd';
const brand2 = machine?.brand.secondary ?? data.brand?.secondary ?? brand;
const arcadeHref = machine?.arcadeHref;
const externalUrl = data.externalUrl;
const livePrimary = Boolean(externalUrl) && !arcadeHref && status !== 'private';
const counter = `${String(index + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;

/* ---------- Korridor ---------- */
const labelOf = (it: HallItem) =>
  isMachine(it)
    ? { de: it.title, en: it.titleEn ?? it.title }
    : it.kind === 'kasse'
      ? { de: D.hall.kasseSub, en: E.hall.kasseSub }
      : { de: D.hall.phoneSub, en: E.hall.phoneSub };
const prev = items[(index - 1 + n) % n];
const next = items[(index + 1) % n];
const prevLabel = labelOf(prev);
const nextLabel = labelOf(next);
---

<aside
  class="hall-panel"
  aria-labelledby="case-title"
  data-brand={entry.id}
  data-kind={kind}
  data-status={status}
  style={`--brand:${brand};--brand-2:${brand2}`}
>
  <!-- Chrome: Zurück, Zähler, Taste — außerhalb der Karte, damit Automat und Schild eine Gruppe bleiben -->
  <div class="hall-panel__chrome">
      <ReadingMode />
      <a class="hall-panel__back" href={homeHref}>
        <span class="hall-panel__back-arrow" aria-hidden="true"><Icon name="arrow-left" size={16} /></span>
        <span data-lang="de">{P.back}</span>
        <span data-lang="en">{PE.back}</span>
      </a>
      <span class="hall-panel__station mono">{counter}</span>
      <span class="hall-panel__key mono" aria-hidden="true">{P.esc}</span>
      <input type="checkbox" id="hall-panel-tall" class="hall-panel__tall" />
      <label for="hall-panel-tall" class="hall-panel__detent mono">
        <span class="hall-panel__detent-more">
          <span data-lang="de">{P.more}</span>
          <span data-lang="en">{PE.more}</span>
        </span>
        <span class="hall-panel__detent-show">
          <Icon name="arrow-up" size={14} />
          <span data-lang="de">{P.showCabinet}</span>
          <span data-lang="en">{PE.showCabinet}</span>
        </span>
      </label>
  </div>

  <div class="hall-panel__card">
    <label for="hall-panel-tall" class="hall-panel__handle" aria-hidden="true"></label>
    <button type="button" class="hall-panel__close mono">
      <Icon name="close" size={15} />
      <span data-lang="de">{P.close}</span>
      <span data-lang="en">{PE.close}</span>
    </button>

    <!-- Körper -->
    <div class="hall-panel__body">
      <p class="hall-panel__kind mono">
        <span>
          <span data-lang="de">{(D.hall.machine as Record<string, string>)[kind]}</span>
          <span data-lang="en">{(E.hall.machine as Record<string, string>)[kind]}</span>
        </span>
        {version && (
          <span class="hall-panel__pair">
            <span class="hall-panel__dot" aria-hidden="true"></span>
            <span class="hall-panel__brand">{version}</span>
          </span>
        )}
        {engine && (
          <span class="hall-panel__pair">
            <span class="hall-panel__dot" aria-hidden="true"></span>
            <span>{engine}</span>
          </span>
        )}
        <span class="hall-panel__pair">
          <span class="hall-panel__dot" aria-hidden="true"></span>
          <span class={`hall-panel__status is-${status}`}>
            <span data-lang="de">{statusDe}</span>
            <span data-lang="en">{statusEn}</span>
          </span>
        </span>
      </p>

      <h1 id="case-title" class="hall-panel__title" tabindex="-1">
        <span data-lang="de">{data.title}</span>
        <span data-lang="en">{data.titleEn ?? data.title}</span>
      </h1>

      <p class="hall-panel__summary">
        <span data-lang="de">{data.summary}</span>
        <span data-lang="en">{data.summaryEn ?? data.summary}</span>
      </p>

      <!-- CTA -->
      <div class="hall-panel__blk" style="--i:0">
        <div class="hall-panel__cta">
          {arcadeHref && (
            <a class="hall-panel__btn hall-panel__btn--coin" href={arcadeHref}>
              <span class="hall-panel__coin" aria-hidden="true"></span>
              <span data-lang="de">{P.play}</span>
              <span data-lang="en">{PE.play}</span>
            </a>
          )}
          {data.landingUrl && (
            <a class="hall-panel__btn hall-panel__btn--coin" href={data.landingUrl} data-astro-reload>
              <span data-lang="de">Website &amp; Download</span>
              <span data-lang="en">Website &amp; download</span>
              <Icon name="external" size={17} />
            </a>
          )}
          {externalUrl && (
            <a class={`hall-panel__btn${livePrimary ? ' hall-panel__btn--coin' : ''}`} href={externalUrl} target="_blank" rel="noreferrer">
              <span data-lang="de">{P.liveApp}</span>
              <span data-lang="en">{PE.liveApp}</span>
              <Icon name="external" size={17} />
            </a>
          )}
          <a class="hall-panel__btn" href={p('contact')}>
            <span data-lang="de">{P.discuss}</span>
            <span data-lang="en">{PE.discuss}</span>
            <Icon name="chevron-right" size={17} />
          </a>
        </div>
        {arcadeHref && (
          <>
            <p class="hall-panel__note hall-panel__note--desk mono">
              <span data-lang="de">{P.webBuildNote}</span>
              <span data-lang="en">{PE.webBuildNote}</span>
            </p>
            <p class="hall-panel__note hall-panel__note--phone mono">
              <span data-lang="de">{P.phoneNote}</span>
              <span data-lang="en">{PE.phoneNote}</span>
            </p>
          </>
        )}
      </div>

      <hr class="hall-panel__rule hall-panel__blk" style="--i:1" />

      <!-- Captures -->
      <div class="hall-panel__blk hall-panel__captures" style="--i:4">
        <CaseCaptures client:load title={data.title} brand={brand} groups={groups} arcadeHref={arcadeHref} />
      </div>

      <!-- MDX-Body -->
      {hasBody && (
        <div class="hall-panel__copy prose-case hall-panel__blk" style="--i:2">
          <slot />
        </div>
      )}

      <!-- Meta -->
      <dl class="hall-panel__meta hall-panel__blk" style="--i:3">
        <div class="hall-panel__cell">
          <dt class="hall-panel__lbl mono">
            <span data-lang="de">{P.role}</span>
            <span data-lang="en">{PE.role}</span>
          </dt>
          <dd class="hall-panel__val">
            <span data-lang="de">{data.role}</span>
            <span data-lang="en">{data.roleEn ?? data.role}</span>
          </dd>
        </div>
        {when && (
          <div class="hall-panel__cell">
            <dt class="hall-panel__lbl mono">
              <span data-lang="de">{P.timeline}</span>
              <span data-lang="en">{PE.timeline}</span>
            </dt>
            <dd class="hall-panel__val">
              <span data-lang="de">{when}</span>
              <span data-lang="en">{whenEn}</span>
            </dd>
          </div>
        )}
        {data.stack.length > 0 && (
          <div class="hall-panel__cell">
            <dt class="hall-panel__lbl mono">{P.stack}</dt>
            <dd class="hall-panel__val">
              <ul class="hall-panel__chips">
                {data.stack.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        )}
        {data.outcome && (
          <div class="hall-panel__cell">
            <dt class="hall-panel__lbl mono">
              <span data-lang="de">{P.outcome}</span>
              <span data-lang="en">{PE.outcome}</span>
            </dt>
            <dd class="hall-panel__val hall-panel__val--dim">
              <span data-lang="de">{data.outcome}</span>
              <span data-lang="en">{data.outcomeEn ?? data.outcome}</span>
            </dd>
          </div>
        )}
      </dl>


      <!-- Readable study in both languages; original German deck remains available. -->
      {docPages.length > 0 && data.document && (
        <div class="hall-panel__blk hall-panel__document" style="--i:5">
          {entry.id === 'mina' ? (
            <>
              <div data-lang="de">
                <MinaStudyDe />
                <details class="mina-original"><summary>Original-Präsentation ansehen · 11 Abschnitte</summary>
                  {docPages.map((page) => <img src={page.src} alt={page.alt} loading="lazy" width="1400" height="1465" />)}
                </details>
              </div>
              <div data-lang="en">
                <CaseDocument client:load labelDe={data.document.labelDe} labelEn={data.document.labelEn}>
                  <MinaStudyEn />
                </CaseDocument>
              </div>
            </>
          ) : (
            <CaseDocument client:load labelDe={data.document.labelDe} labelEn={data.document.labelEn} pages={docPages} />
          )}
        </div>
      )}
    </div>

    <!-- Fuß: der Korridor -->
    <nav class="hall-panel__corridor" aria-label="Stationen">
      <a class="hall-panel__cor hall-panel__cor--prev" href={prev.href}>
        <span class="hall-panel__cor-dir mono">
          <span class="hall-panel__cor-ch" aria-hidden="true"><Icon name="chevron-left" size={16} /></span>
          <span class="hall-panel__cor-word">
            <span data-lang="de">{P.prev}</span>
            <span data-lang="en">{PE.prev}</span>
          </span>
        </span>
        <span class="hall-panel__cor-title">
          <span data-lang="de">{prevLabel.de}</span>
          <span data-lang="en">{prevLabel.en}</span>
        </span>
      </a>

      <div class="hall-panel__dots">
        {items.map((it, i) => {
          const l = labelOf(it);
          return (
            <a
              class={`hall-panel__dot-link${i === index ? ' is-on' : ''}`}
              href={it.href}
              style={`--t:${isMachine(it) ? it.brand.primary : '#c8daf4'}`}
              aria-current={i === index ? 'page' : undefined}
              tabindex="-1"
            >
              <span class="sr-only"><span data-lang="de">{l.de}</span><span data-lang="en">{l.en}</span></span>
              <span class="hall-panel__dot-tip mono" aria-hidden="true">
                <span data-lang="de">{l.de}</span>
                <span data-lang="en">{l.en}</span>
              </span>
            </a>
          );
        })}
      </div>

      <a class="hall-panel__cor hall-panel__cor--next" href={next.href}>
        <span class="hall-panel__cor-dir mono">
          <span class="hall-panel__cor-word">
            <span data-lang="de">{P.next}</span>
            <span data-lang="en">{PE.next}</span>
          </span>
          <span class="hall-panel__cor-ch" aria-hidden="true"><Icon name="chevron-right" size={16} /></span>
        </span>
        <span class="hall-panel__cor-title">
          <span data-lang="de">{nextLabel.de}</span>
          <span data-lang="en">{nextLabel.en}</span>
        </span>
      </a>
    </nav>
  </div>
</aside>

<p class="hall-panel__hint mono" aria-hidden="true">
  <span data-lang="de">{P.zoomHint}</span>
  <span data-lang="en">{PE.zoomHint}</span>
</p>
