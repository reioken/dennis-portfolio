<button type="button" class="hall-panel__reading" aria-pressed="false">
  <span class="reading-open"><span data-lang="de">Lesemodus</span><span data-lang="en">Reading view</span></span>
  <span class="reading-close"><span data-lang="de">Lesemodus schließen</span><span data-lang="en">Close reading view</span></span>
</button>
<script>
  let cleanup: (() => void) | undefined;
  function initReading() {
    cleanup?.();
    const button = document.querySelector<HTMLButtonElement>('.hall-panel__reading');
    if (!button) return;
    const root = document.documentElement;
    const hall = document.querySelector<HTMLElement>('.hall');
    const set = (on: boolean, reframe = true) => {
      const wasReading = root.classList.contains('is-reading');
      root.classList.toggle('is-reading', on);
      button.setAttribute('aria-pressed', String(on));
      if (hall) hall.inert = on;
      // Resizing in reading view measures its expanded panel. Restore the
      // regular camera frame only after its normal CSS geometry is active.
      if (wasReading && !on && reframe) document.dispatchEvent(new CustomEvent('hall:reframe'));
    };
    const toggle = () => set(!root.classList.contains('is-reading'));
    const key = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && root.classList.contains('is-reading')) {
        e.preventDefault(); e.stopImmediatePropagation(); set(false); button.focus();
      }
    };
    const closeForGallery = (event: Event) => { if ((event as CustomEvent).detail?.on) set(false, false); };
    document.addEventListener('hall:closeup', closeForGallery);
    button.addEventListener('click', toggle);
    window.addEventListener('keydown', key, true);
    // Navigation and gallery entry already select their own destination frame.
    cleanup = () => { document.removeEventListener('hall:closeup', closeForGallery); set(false, false); button.removeEventListener('click', toggle); window.removeEventListener('keydown', key, true); };
  }
  document.addEventListener('astro:page-load', initReading);
  document.addEventListener('astro:before-swap', () => cleanup?.());
  initReading();
</script>
