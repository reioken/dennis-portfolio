---
/**
 * Klassische Projektseite (Artikel-Layout) — für Einträge, die keinen Automaten in der Halle haben
 * (Archiv). Hallen-Projekte laufen über CaseOverlay.astro vor der 3D-Bühne.
 */
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import CaseMedia from './CaseMedia';
import CaseSurfaceStack from './CaseSurfaceStack';
import CaseDocument from './CaseDocument';
import MinaStudyEn from './MinaStudyEn.astro';
import MinaStudyDe from './MinaStudyDe.astro';
import CertificateCard from './CertificateCard.astro';
import CaseAdjacent from './CaseAdjacent.astro';
import { toAvif } from '../../lib/img';
import { p } from '../../lib/paths';

type WorkLite = { id: string; data: { title: string; role: string; cover: string; titleEn?: string; roleEn?: string } };

interface Props {
  entry: CollectionEntry<'work'>;
  prev: WorkLite;
  next: WorkLite;
  index: number;
  total: number;
  /** Text ist vorhanden (der Body wird als Slot gerendert) */
  hasBody: boolean;
}

const { entry, prev, next, index, total, hasBody } = Astro.props;
const data = entry.data;
const asset = (src: string) => p(src.replace(/^\//, ''));

function hiAsset(sitePath: string): string | undefined {
  const clean = sitePath.replace(/^\//, '');
  if (clean === 'media/mina/cover.webp') return undefined;
  const candidates = [clean.replace(/(\.\w+)$/, '@2x.webp'), clean.replace(/(\.\w+)$/, '@2x$1')];
  for (const rel of candidates) {
    if (fs.existsSync(path.join(process.cwd(), 'public', rel))) return p(rel);
  }
  return undefined;
}

const coverSrc = asset(data.cover);
const coverHi = hiAsset(data.cover);
const galleryOnly = data.gallery
  .map((g, i) => ({ path: g.replace(/^\//, ''), alt: data.galleryAlts?.[i] }))
  .filter((g) => g.path !== data.cover.replace(/^\//, ''));
const galleryOnlyEn = data.gallery
  .map((g, i) => ({ path: g.replace(/^\//, ''), alt: data.galleryAltsEn?.[i] }))
  .filter((g) => g.path !== data.cover.replace(/^\//, ''));

const images = [
  {
    src: coverSrc,
    srcHi: coverHi,
    alt: data.coverAlt ?? `${data.title} Cover`,
    altEn: data.coverAltEn ?? data.galleryAltsEn?.[0],
  },
  ...galleryOnly.map((g, i) => ({
    src: asset(g.path),
    srcHi: hiAsset(g.path),
    alt: g.alt ?? `${data.title} — ${i + 1}`,
    altEn: galleryOnlyEn[i]?.alt,
  })),
];

const docPages = (data.document?.pages ?? []).map((page, i) => ({
  src: asset(page),
  alt: `${data.title} Case Study — Abschnitt ${i + 1}`,
}));

const surfaces = (data.surfaces ?? []).map((surface) => ({
  id: surface.id,
  labelDe: surface.labelDe,
  labelEn: surface.labelEn,
  blurbDe: surface.blurbDe,
  blurbEn: surface.blurbEn,
  variant: surface.variant,
  images: surface.gallery.map((g, i) => ({
    src: asset(g),
    srcHi: hiAsset(g),
    alt: surface.alts?.[i] ?? `${data.title} ${surface.labelDe} — ${i + 1}`,
    altEn: surface.altsEn?.[i],
  })),
}));

const when = data.timeline || data.year;
const logoSrc = data.logo ? asset(data.logo) : undefined;
---

<article class="case-page">
  <header class="case-page__intro wrap">
    <div class="case-page__main">
      {
        logoSrc && (
          <div class="case-page__brand">
            <picture>
              {toAvif(logoSrc) && <source type="image/avif" srcset={toAvif(logoSrc)} />}
              <img class="case-page__logo" src={logoSrc} alt={`${data.title} logo`} width={520} height={120} decoding="async" />
            </picture>
          </div>
        )
      }
      <p class="case-page__eyebrow">
        {
          data.tags.includes('archive') && (
            <>
              <span>
                <span data-lang="de">Archiv</span>
                <span data-lang="en">Archive</span>
              </span>
              <span class="case-page__dot" aria-hidden="true">·</span>
            </>
          )
        }
        <span>
          <span data-lang="de">{data.role}</span>
          <span data-lang="en">{data.roleEn ?? data.role}</span>
        </span>
        {
          when && (
            <>
              <span class="case-page__dot" aria-hidden="true">·</span>
              <span>
                <span data-lang="de">{when}</span>
                <span data-lang="en">{data.timelineEn ?? data.yearEn ?? when}</span>
              </span>
            </>
          )
        }
      </p>
      <h1 class="case-page__title">
        <span data-lang="de">{data.title}</span>
        <span data-lang="en">{data.titleEn ?? data.title}</span>
      </h1>
      <p class="case-page__summary">
        <span data-lang="de">{data.summary}</span>
        <span data-lang="en">{data.summaryEn ?? data.summary}</span>
      </p>
      {
        hasBody && (
          <div class="case-page__copy prose-case">
            <slot />
          </div>
        )
      }
      {
        data.landingUrl && (
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="btn btn--primary" href={data.landingUrl} data-astro-reload>
              <span data-lang="de">Website &amp; Download</span>
              <span data-lang="en">Website &amp; download</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        )
      }
      {
        data.externalUrl && (
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="btn btn--primary" href={data.externalUrl} target="_blank" rel="noopener noreferrer">
              <span data-lang="de">Live-App öffnen</span>
              <span data-lang="en">Open live app</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        )
      }
    </div>

    <aside class="case-page__aside" aria-label="Project details">
      {
        data.stack.length > 0 && (
          <div class="case-page__block">
            <h2 class="case-page__label">Stack</h2>
            <ul class="case-page__chips">
              {data.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        data.outcome && (
          <div class="case-page__block">
            <h2 class="case-page__label">
              <span data-lang="de">Ergebnis</span>
              <span data-lang="en">Outcome</span>
            </h2>
            <p class="case-page__outcome">
              <span data-lang="de">{data.outcome}</span>
              <span data-lang="en">{data.outcomeEn ?? data.outcome}</span>
            </p>
          </div>
        )
      }
    </aside>
  </header>

  {
    surfaces.length > 0 ? (
      <CaseSurfaceStack client:load title={data.title} surfaces={surfaces} />
    ) : docPages.length > 0 && data.document ? (
      entry.id === 'mina' ? (
        <>
          <div data-lang="de">
            <CaseDocument client:load labelDe={data.document.labelDe} labelEn={data.document.labelEn}>
              <MinaStudyDe />
              <details><summary>Original-Präsentation ansehen · 11 Abschnitte</summary>
                {docPages.map((page) => <img src={page.src} alt={page.alt} loading="lazy" width="1400" height="1465" style="max-width:100%;height:auto" />)}
              </details>
            </CaseDocument>
          </div>
          <div data-lang="en">
            <CaseDocument client:load labelDe={data.document.labelDe} labelEn={data.document.labelEn}>
              <MinaStudyEn />
            </CaseDocument>
          </div>
        </>
      ) : (
        <CaseDocument client:load labelDe={data.document.labelDe} labelEn={data.document.labelEn} pages={docPages} />
      )
    ) : (
      <CaseMedia client:load title={data.title} images={images} coverCount={0} variant={entry.id === 'berry' ? 'phone' : 'desktop'} />
    )
  }

  {entry.id === 'mina' && <CertificateCard />}

  <div class="wrap">
    <CaseAdjacent prev={prev} next={next} index={index} total={total} />
  </div>
</article>
