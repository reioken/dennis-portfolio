 .mina-reading h4 { font-size: 18px; margin: 0 0 8px; }
 .mina-reading p { margin: 0 0 16px; }
 .mina-reading section { margin-top: 36px; }
 .mina-reading__eyebrow { font-size: 13px; font-weight: 700; color: #46624e; }
 .mina-reading ul, .mina-reading ol { padding-left: 22px; list-style: revert; }
 .mina-reading li { margin: 8px 0; }
 .mina-reading__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0; }
 .mina-reading__stats div { padding: 16px; background: #e3ecdc; border-radius: 8px; }
 .mina-reading__stats dd { font-size: 30px; font-weight: 700; }
 .mina-reading__stats dt, .mina-reading__note { font-size: 14px; }
 .mina-reading__person { border-left: 3px solid #749171; padding-left: 18px; margin: 24px 0; }
 .mina-reading figure { margin: 24px auto; max-width: 460px; }
