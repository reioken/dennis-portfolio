---
/** Poster portrait and complete profile inside the persistent hall panel. */
import type { HallItem, HallMachine } from '../hall/Hall';
import { copy } from '../../lib/i18n';
import { p } from '../../lib/paths';
import { site, skills, timeline, education, languages } from '../../lib/site';
import './hall-panel.css';
import Icon from '../icons/Icon';
import PanelBack from './PanelBack.astro';
import './about-panel.css';

interface Props {
  /** Alle Stationen in Hallenreihenfolge (buildHallItems().items) */
  items: HallItem[];
  /** Index der Kasse in `items` */
  index: number;
  homeHref: string;
}

const { items, index, homeHref } = Astro.props;
const n = items.length;

const isMachine = (it: HallItem | undefined): it is HallMachine => Boolean(it) && it!.kind !== 'kasse' && it!.kind !== 'phone';
const portrait = p('media/me/portrait-wide-v2-1200.webp');

const D = copy.de;
const E = copy.en;
const P = D.panel;
const PE = E.panel;
const A = D.about;
const AE = E.about;
const H = D.hall;
const HE = E.hall;
const avail = site.availability;

/* Die Kasse trägt das Eis der Halle (hallScene: '#c8daf4' für Kasse und Telefon) */
const brand = '#c8daf4';
const brand2 = '#4a82fe';
const counter = `${String(index + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;

/* Der Nachname bleibt zusammen, wenn der Titel umbricht */
const [firstName, ...rest] = site.name.split(' ');
const surname = rest.join(' ');

/* ---------- Korridor ---------- */
const labelOf = (it: HallItem) =>
  isMachine(it)
    ? { de: it.title, en: it.titleEn ?? it.title }
    : it.kind === 'kasse'
      ? { de: H.kasseSub, en: HE.kasseSub }
      : { de: H.phoneSub, en: HE.phoneSub };
const prev = items[(index - 1 + n) % n];
const next = items[(index + 1) % n];
const prevLabel = labelOf(prev);
const nextLabel = labelOf(next);
---

<aside
  class="hall-panel hall-panel--about"
  aria-labelledby="case-title"
  data-brand="kasse"
  data-kind="kasse"
  style={`--brand:${brand};--brand-2:${brand2}`}
>
  <!-- Chrome: Zurück, Zähler, Taste — außerhalb der Karte, damit Automat und Schild eine Gruppe bleiben -->
  <div class="hall-panel__chrome">
      <PanelBack homeHref={homeHref} />
      <span class="hall-panel__station mono">{counter}</span>
      <span class="hall-panel__key mono" aria-hidden="true">{P.esc}</span>
      <input type="checkbox" id="hall-panel-tall" class="hall-panel__tall" />
      <label for="hall-panel-tall" class="hall-panel__detent mono">
        <span class="hall-panel__detent-more">
          <span data-lang="de">{P.more}</span>
          <span data-lang="en">{PE.more}</span>
        </span>
        <span class="hall-panel__detent-show">
          <Icon name="arrow-up" size={14} />
          <span data-lang="de">{P.showCabinet}</span>
          <span data-lang="en">{PE.showCabinet}</span>
        </span>
      </label>
  </div>

  <div class="hall-panel__card">
    <label for="hall-panel-tall" class="hall-panel__handle" aria-hidden="true"></label>

    <div class="hall-panel__body about-poster-body">
      <header class="about-poster" id="about-intro">
        <div class="about-poster__image">
          <img src={portrait} srcset={`${p('media/me/portrait-wide-v2-640.webp')} 640w, ${portrait} 1200w`} sizes="(max-width: 599px) 53vw, (min-width: 1200px) 640px, 54vw" alt={site.name} width="1200" height="1138" loading="eager" decoding="async" />
        </div>
        <div class="about-poster__copy">
          <p class="about-poster__eyebrow"><span data-lang="de">{H.kasseSub}</span><span data-lang="en">{HE.kasseSub}</span><span class="about-panel__open"><span data-lang="de">{avail.de.open}</span><span data-lang="en">{avail.en.open}</span></span></p>
          <h1 id="case-title" tabindex="-1" class="about-poster__name"><span>{firstName}</span><span class="about-poster__surname">{surname.split('-').map((part, i) => <>{i > 0 && <><span>-</span><wbr /></>}{part}</>)}</span></h1>
          <p class="about-poster__role"><span data-lang="de">{A.role}</span><span data-lang="en">{AE.role}</span></p>
          <p class="about-poster__statement"><span data-lang="de">{A.posterLead}</span><span data-lang="en">{AE.posterLead}</span></p>
          <div class="about-poster__actions">
            <a class="about-poster__button about-poster__button--primary" href={p('contact')}><Icon name="contact" size={19} /><span data-lang="de">{A.contact}</span><span data-lang="en">{AE.contact}</span></a>
            <a class="about-poster__button" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn<Icon name="external" size={18} /></a>
          </div>
        </div>
      </header>
      <section class="about-highlights" aria-label="Design &amp; Profil">
        <div class="about-highlights__inner">
          <a class="about-specialty" href="#about-expertise"><span class="about-specialty__top"><Icon name="pen-nib" size={32} /><span>01</span></span><span class="about-specialty__title">Art Direction</span><span class="about-specialty__line" aria-hidden="true"></span></a>
          <a class="about-specialty" href="#about-expertise"><span class="about-specialty__top"><Icon name="cursor" size={32} /><span>02</span></span><span class="about-specialty__title">UX/UI</span><span class="about-specialty__line" aria-hidden="true"></span></a>
          <a class="about-specialty" href="#about-expertise"><span class="about-specialty__top"><Icon name="cube" size={32} /><span>03</span></span><span class="about-specialty__title"><span data-lang="de">Eigene Produkte</span><span data-lang="en">Own products</span></span><span class="about-specialty__line" aria-hidden="true"></span></a>
          <ul class="about-highlights__facts">
            <li><Icon name="work" size={20} /><span data-lang="de">{avail.de.role} bei {avail.de.employer}</span><span data-lang="en">{avail.en.role} at {avail.en.employer}</span></li>
            <li><Icon name="education" size={22} /><span data-lang="de">6+ Jahre Agentur &amp; Inhouse</span><span data-lang="en">6+ years agency &amp; in-house</span></li>
            <li><Icon name="location" size={20} /><span>Mannheim / Heidelberg</span></li>
          </ul>
        </div>
      </section>
      <nav class="about-index" aria-label="Über mich / About sections">
        <a href="#about-story"><span class="about-index__number">01</span><span data-lang="de">Über mich</span><span data-lang="en">About</span></a>
        <a href="#about-experience"><span class="about-index__number">02</span><span data-lang="de">Erfahrung</span><span data-lang="en">Experience</span></a>
        <a href="#about-training"><span class="about-index__number">03</span><span data-lang="de">Ausbildung</span><span data-lang="en">Education</span></a>
        <a href="#about-expertise"><span class="about-index__number">04</span>Skills</a>
      </nav>
      <div class="about-editorial">
        <section class="about-story about-section" id="about-story" aria-labelledby="about-story-title">
          <div class="about-section__heading"><span class="about-section__number">01</span><h2 id="about-story-title"><span data-lang="de">Über mich</span><span data-lang="en">About me</span></h2></div>
          <div class="about-story__copy">
            <p class="about-story__lead"><span data-lang="de" data-edit="about.lead.de">{A.lead}</span><span data-lang="en" data-edit="about.lead.en">{AE.lead}</span></p>
            <p><span data-lang="de" data-edit="about.body.de">{A.body}</span><span data-lang="en" data-edit="about.body.en">{AE.body}</span></p>
          </div>
          <dl class="about-facts">
            <div><dt><Icon name="work" size={18} /><span data-lang="de">{P.role}</span><span data-lang="en">{PE.role}</span></dt><dd><span data-lang="de">{avail.de.role} bei {avail.de.employer}</span><span data-lang="en">{avail.en.role} at {avail.en.employer}</span></dd></div>
            <div><dt><span data-lang="de">{D.contact.location}</span><span data-lang="en">{E.contact.location}</span></dt><dd><span data-lang="de">{site.location}</span><span data-lang="en">Mannheim/Heidelberg area</span></dd></div>
            <div><dt><span data-lang="de">{A.languagesLabel}</span><span data-lang="en">{AE.languagesLabel}</span></dt><dd>{languages.map(l => <span class="about-facts__language"><span data-lang="de">{l.name.de} · {l.level.de}</span><span data-lang="en">{l.name.en} · {l.level.en}</span></span>)}</dd></div>
            <div><dt><Icon name="contact" size={18} />E-Mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          </dl>
        </section>
        <section class="about-section" id="about-experience" aria-labelledby="about-timeline">
          <div class="about-section__heading"><span class="about-section__number">02</span><h2 id="about-timeline"><span data-lang="de">{A.timelineLabel}</span><span data-lang="en">{AE.timelineLabel}</span></h2><Icon name="work" size={24} /></div>
          <ol class="about-career">
            {timeline.map((t,i) => <li class={`about-career__entry${i === 0 ? ' about-career__entry--current' : ''}`}>
              <span class="about-career__year"><span data-lang="de" data-edit={`timeline.${i}.year`}>{t.year}</span><span data-lang="en" data-edit={`timeline.${i}.yearEn`}>{t.yearEn}</span></span>
              <div><h3><span data-lang="de" data-edit={`timeline.${i}.title.de`}>{t.title.de}</span><span data-lang="en" data-edit={`timeline.${i}.title.en`}>{t.title.en}</span></h3><p><span data-lang="de" data-edit={`timeline.${i}.body.de`}>{t.body.de}</span><span data-lang="en" data-edit={`timeline.${i}.body.en`}>{t.body.en}</span></p></div>
            </li>)}
          </ol>
        </section>
        <section class="about-section" id="about-training" aria-labelledby="about-education">
          <div class="about-section__heading"><span class="about-section__number">03</span><h2 id="about-education"><span data-lang="de">{A.educationLabel}</span><span data-lang="en">{AE.educationLabel}</span></h2></div>
          <div class="about-education">
            {education.map((e,i) => <article class="about-education__entry">
              <span class="about-career__year" data-edit={`education.${i}.year`}>{e.year}</span>
              <h3><span data-lang="de" data-edit={`education.${i}.title.de`}>{e.title.de}</span><span data-lang="en" data-edit={`education.${i}.title.en`}>{e.title.en}</span></h3>
              <p><span data-lang="de" data-edit={`education.${i}.body.de`}>{e.body.de}</span><span data-lang="en" data-edit={`education.${i}.body.en`}>{e.body.en}</span></p>
              {'url' in e && e.url ? <a class="about-certificate" href={e.url} target="_blank" rel="noopener noreferrer"><span data-lang="de">{e.urlLabel?.de ?? 'Zertifikat ansehen'}</span><span data-lang="en">{e.urlLabel?.en ?? 'View certificate'}</span><Icon name="external" size={17} /></a> : null}
            </article>)}
          </div>
        </section>
        <section class="about-section" id="about-expertise" aria-labelledby="about-skills">
          <div class="about-section__heading"><span class="about-section__number">04</span><h2 id="about-skills"><span data-lang="de">{A.skillsLabel}</span><span data-lang="en">{AE.skillsLabel}</span></h2></div>
          <div class="about-expertise">{skills.map(s => <div class="about-expertise__group"><h3><span data-lang="de">{s.group.de}</span><span data-lang="en">{s.group.en}</span></h3><ul>{s.items.de.map((item,j) => <li><span data-lang="de">{item}</span><span data-lang="en">{s.items.en[j]}</span></li>)}</ul></div>)}</div>
        </section>
        <div class="about-signoff"><a href={p('contact')}><span data-lang="de">{A.contact}</span><span data-lang="en">{AE.contact}</span><Icon name="external" size={25} /></a><a href="#about-intro" class="about-signoff__top"><span data-lang="de">Nach oben</span><span data-lang="en">Back to top</span><Icon name="arrow-up" size={18} /></a></div>
      </div>
    </div>


    <!-- Fuß: der Korridor -->
    <nav class="hall-panel__corridor" aria-label="Stationen">
      <a class="hall-panel__cor hall-panel__cor--prev" href={prev.href}>
        <span class="hall-panel__cor-dir mono">
          <span class="hall-panel__cor-ch" aria-hidden="true"><Icon name="chevron-left" size={16} /></span>
          <span class="hall-panel__cor-word">
            <span data-lang="de">{P.prev}</span>
            <span data-lang="en">{PE.prev}</span>
          </span>
        </span>
        <span class="hall-panel__cor-title">
          <span data-lang="de">{prevLabel.de}</span>
          <span data-lang="en">{prevLabel.en}</span>
        </span>
      </a>

      <div class="hall-panel__dots">
        {items.map((it, i) => {
          const l = labelOf(it);
          return (
            <a
              class={`hall-panel__dot-link${i === index ? ' is-on' : ''}`}
              href={it.href}
              style={`--t:${isMachine(it) ? it.brand.primary : '#c8daf4'}`}
              aria-current={i === index ? 'page' : undefined}
              tabindex="-1"
            >
              <span class="sr-only"><span data-lang="de">{l.de}</span><span data-lang="en">{l.en}</span></span>
              <span class="hall-panel__dot-tip mono" aria-hidden="true">
                <span data-lang="de">{l.de}</span>
                <span data-lang="en">{l.en}</span>
              </span>
            </a>
          );
        })}
      </div>

      <a class="hall-panel__cor hall-panel__cor--next" href={next.href}>
        <span class="hall-panel__cor-dir mono">
          <span class="hall-panel__cor-word">
            <span data-lang="de">{P.next}</span>
            <span data-lang="en">{PE.next}</span>
          </span>
          <span class="hall-panel__cor-ch" aria-hidden="true"><Icon name="chevron-right" size={16} /></span>
        </span>
        <span class="hall-panel__cor-title">
          <span data-lang="de">{nextLabel.de}</span>
          <span data-lang="en">{nextLabel.en}</span>
        </span>
      </a>
    </nav>
  </div>
</aside>

<p class="hall-panel__hint mono" aria-hidden="true">
  <span data-lang="de">{P.zoomHint}</span>
  <span data-lang="en">{PE.zoomHint}</span>
</p>
