---
import './hall-loading.css';
import { site } from '../../lib/site';
import { entrance } from '../../lib/entrance-copy';
import { p } from '../../lib/paths';
import SignatureLogo from '../brand/SignatureLogo';
/**
 * Vor dem ersten Paint (und nach jedem Client-Seitenwechsel, data-astro-rerun): mit WebGL bleibt
 * die CSS-Kulisse verborgen, bis die 3D-Bühne steht — kein kurzes Aufblitzen der alten Reihe.
 * Läuft eine Bühne bereits (persistente Insel), passiert nichts. Der Probe-Kontext wird sofort
 * wieder freigegeben, Chrome hält nur ~16 WebGL-Kontexte pro Seite.
 */
---

<div class="hall-startup">
  <div class="hall-startup__identity">
    <div class="hall-startup__logo"><SignatureLogo instance="startup" /></div>
    <p class="hall-startup__name"><span data-lang="de"><span class="hall-startup__line">{entrance.first.de}</span><em class="hall-startup__line">{entrance.second.de}</em></span><span data-lang="en"><span class="hall-startup__line">{entrance.first.en}</span><em class="hall-startup__line">{entrance.second.en}</em></span></p>
    <p class="hall-startup__role">{site.role}</p>
  </div>
  <div class="hall-startup__stage">
    <span class="hall-startup__emblem" aria-hidden="true">
      <span class="hall-startup__orbit">
        <i></i><i></i><i></i><i></i>
      </span>
      <span class="hall-startup__prism">
        <span class="hall-startup__cube"><i></i><i></i><i></i><i></i><i></i><i></i></span>
      </span>
    </span>
  </div>
  <p class="hall-startup__label" role="status" aria-live="polite"><span data-lang="de">Gleich geht das Licht an.</span><span data-lang="en">Lights on in a moment.</span></p>
  <nav class="hall-startup__routes" aria-label="Portfolio">
    <a href={p('work')}><span data-lang="de">Schon mal die Projekte ansehen</span><span data-lang="en">Take a look at the projects</span><span aria-hidden="true">↗</span></a>
    <a href={p('contact')}><span data-lang="de">Kontakt</span><span data-lang="en">Contact</span><span aria-hidden="true">↗</span></a>
  </nav>
</div>

<script is:inline data-astro-rerun>
  try {
    var d = document.documentElement;
    d.classList.remove('gl-pending');
    // Phone home is the native exhibition; projects are native reading pages.
    // Neither waits for (or boots) the hidden 3D room.
    var nativeCase = window.innerWidth < 900 && (/^\/(en\/)?(?:work\/[^/]+|about|contact)\/?$/.test(location.pathname) || /^\/(en\/?)?$/.test(location.pathname));
    // hall.css takes the hidden CSS row out of the render tree there: its lazy images (other stations' screens,
    // characters, the portrait, ~1.1 MB) loaded behind the reading page. hall-session.ts sets it on client swaps.
    d.classList.toggle('hall-native', nativeCase);
    if (!nativeCase && !document.querySelector('.hall.is-3d, .hall[data-startup-fallback]')) {
      var ok = window.__glOk;
      if (ok === undefined) {
        var c = document.createElement('canvas');
        var g = c.getContext('webgl2') || c.getContext('webgl');
        ok = window.__glOk = !!g;
        var l = g && g.getExtension('WEBGL_lose_context');
        if (l) l.loseContext();
      }
      if (ok) d.classList.add('gl-pending');
    }
  } catch (e) {}
</script>

<script>
  // The entry links remain usable during preparation. If readiness dismisses
  // a focused link, continue at its persistent counterpart in the header.
  // The header joins the reveal (hall-loading.css): it can take focus only once
  // gl-pending is gone and its visibility transition runs, which may be after the
  // link itself has disappeared. Retry per frame until the header has it.
  let stopWatching: (() => void) | undefined;
  function watchStartupFocus() {
    stopWatching?.();
    const startup = document.querySelector('.hall-startup');
    if (!startup) return;
    let frame = 0;
    const observer = new MutationObserver(() => {
      // Startup phase, not power: under reduced motion the room skips ignition and drops data-power instead.
      const ready = document.querySelector('.hall__stage[data-startup-phase="ready"], .hall[data-startup-fallback]');
      if (!ready) return;
      observer.disconnect();
      const focused = document.activeElement;
      if (!(focused instanceof HTMLAnchorElement && startup.contains(focused))) return;
      const shown = (el: Element) => el.getClientRects().length > 0 && getComputedStyle(el).visibility === 'visible';
      const until = performance.now() + 3000;
      const handOff = () => {
        frame = 0;
        const active = document.activeElement ?? document.body;
        // Focus elsewhere, or on the page while the link is still shown: the visitor moved on.
        if (active !== focused && !(active === document.body && !shown(focused))) return;
        const destination = [...document.querySelectorAll<HTMLAnchorElement>('.site-nav a')]
          .find(link => link.href === focused.href && shown(link));
        destination?.focus({ preventScroll: true });
        if (document.activeElement !== destination && performance.now() < until) frame = requestAnimationFrame(handOff);
      };
      handOff();
    });
    observer.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['data-power', 'data-startup-phase', 'data-startup-fallback'] });
    stopWatching = () => { observer.disconnect(); cancelAnimationFrame(frame); };
  }
  document.addEventListener('astro:page-load', watchStartupFocus);
  document.addEventListener('astro:before-swap', () => stopWatching?.());
  watchStartupFocus();
</script>
